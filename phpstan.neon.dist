parameters:
    level: 0
    phpVersion: 80100 # PHP 8.1
    paths:
        - app/controllers
        - cli
        - config
        - db/migrations
        - lib
        - tests/functional
        - tests/jsonapi
        - tests/unit
        - tests/_support
    scanDirectories:
        - app/controllers
        - cli
        - lib
        - vendor
    excludePaths:
        - config/config_local_develop.inc.php
        - lib/ilias_interface/studip_referrer_7x.php
        - lib/ilias_interface/studip_referrer_8x.php
        - lib/ilias_interface/studip_referrer_9x.php
        - lib/ilias_interface/studip_referrer_10x.php
    tmpDir: .caches
    ignoreErrors:
        -
            message: '#Unsafe usage of new static\(\)\.#'
            path: lib/classes/SimpleORMap.php
        -
            identifier: class.notFound
            message: '#^Parameter \$event of method Studip\\Build\\ComposerHooks::configureAttributeCollector\(\) has invalid type Composer\\Script\\Event\.$#'
            path: lib/classes/Build/ComposerHooks.php
includes:
  - ./composer/zorac/phpstan-php-di/extension.neon
